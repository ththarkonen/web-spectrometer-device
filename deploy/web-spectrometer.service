[Unit]
Description=Web Spectrometer device API
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/web-spectrometer/config.json

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/web-spectrometer
Environment=SPECTROMETER_CONFIG=/etc/web-spectrometer/config.json
ExecStart=/opt/web-spectrometer/.venv/bin/python -m pi.camera_service --config /etc/web-spectrometer/config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
