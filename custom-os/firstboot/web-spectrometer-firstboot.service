[Unit]
Description=Provision Web Spectrometer identity and setup file
Wants=cloud-init.target
After=local-fs.target cloud-init.target
ConditionPathExists=!/etc/web-spectrometer/firstboot-complete

[Service]
Type=oneshot
TimeoutStartSec=5min
ExecStart=/usr/local/sbin/web-spectrometer-firstboot

[Install]
WantedBy=multi-user.target
