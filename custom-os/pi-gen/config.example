# Copy this file to pi-gen/config before building.
IMG_NAME='web-spectrometer-pi-os'
RELEASE='trixie'
DEPLOY_COMPRESSION='xz'
COMPRESSION_LEVEL='1'

# Raspberry Pi OS Lite plus the Web Spectrometer appliance stage.
STAGE_LIST='stage0 stage1 stage2 stage-web-spectrometer'

# Users should set Wi-Fi, locale, SSH, and optional user account with
# Raspberry Pi Imager when they flash the released image.
ENABLE_SSH=0

# Keep the appliance headless and avoid the first-boot console user setup flow.
# prepare-pi-gen-stage.sh appends a random FIRST_USER_PASS to generated build
# configs. If you create pi-gen/config manually, set FIRST_USER_PASS to a
# release-build-specific random value before building.
FIRST_USER_NAME='spectrometer'
DISABLE_FIRST_BOOT_USER_RENAME=1
